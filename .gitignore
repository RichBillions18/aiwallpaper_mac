# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# 【第8阶段 · Git】以下文件不提交：依赖可 pnpm install 恢复，密钥绝不能进仓库

# dependencies（pnpm install 会重新下载）
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js（build 产物，pnpm build 会重新生成）
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files：API 密钥、数据库 URL 等，本地用 .env，线上用 Vercel Environment Variables
.env*

# vercel（本地 vercel link 产生的配置，不必提交）
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
